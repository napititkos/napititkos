# Másold .env.local néven, és töltsd ki. Éles környezetben (Vercel) ezeket a
# Project Settings > Environment Variables alatt add meg. Titkos értéket soha ne commitolj.

# Adatbázis (Redis, TCP): pl. redis://... vagy rediss://... (TLS-sel)
REDIS_URL=

# Auth.js: titkos kulcs (pl. `openssl rand -base64 33`) és a Google OAuth kliens
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A levelekben szereplő linkek alapcíme. Élesben kötelezően a végleges cím,
# az Origin/Host fejlécből SOHA nem számoljuk. Helyben: http://localhost:3000
SITE_URL=https://www.napititkos.hu

# Admin felület jelszava - hosszú, egyedi legyen. A cseréje minden admin
# munkamenetet érvénytelenít. (Opcionális: külön ADMIN_SESSION_SECRET is megadható.)
# A jelszót a szerver csak admin jogú, bejelentkezett fióktól fogadja el.
ADMIN_PASSWORD=

# Email küldés (Resend)
RESEND_API_KEY=
RESEND_FROM=Titkosírás <titkositas@napititkos.hu>
